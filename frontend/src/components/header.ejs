<link rel="stylesheet" href="/css/header.css">

<header class="bg-info bg-opacity-25 py-3 shadow-sm">
  <div class="container">
    <!-- Top row with title and profile -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="m-0 fs-3 fw-bold">Event Management</h1>
      
      <div class="d-flex align-items-center gap-2">
        <!-- Date display -->
        <span class="bg-white px-3 py-2 rounded-pill border shadow-sm small dm-date-display" id="display-time" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#dmDateModal">
          <!-- Will be filled by JavaScript -->
        </span>
        
        <!-- Toggle size button -->
        <button id="toggleSizeBtn" class="btn btn-light border shadow-sm" title="Toggle fullscreen">
          <i id="toggleIcon" class="bi bi-arrows-fullscreen"></i>
        </button>
        <!-- Profile button -->
        <div class="bg-white rounded-circle p-2 shadow-sm" style="width: 40px; height: 40px; display: flex; justify-content: center; align-items: center; cursor: pointer;" onclick="changeTab('profile')" title="Profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664z"/>
          </svg>
        </div>
        
      </div>
      
    </div>
    
    <!-- Search section with improved layout -->
    <div class="card shadow-sm border-0 rounded-3">
      <div class="card-body">
        <div class="row g-3 align-items-center">
          <!-- Search input with button directly next to it -->
          <div class="col-md-6">
            <div class="input-group">
              <input type="text" id="searchInput" class="form-control" placeholder="Enter event name or leave empty for date search" />
              <button class="btn btn-primary" onclick="performSearch()">
                <i class="bi bi-search me-1"></i> Search
              </button>
            </div>
          </div>
          
          <!-- Search type radios - more compact -->
          <div class="col-md-3">
            <div class="d-flex gap-3 justify-content-center">
              <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="searchType" id="searchByTitle" value="title" checked>
                <label class="form-check-label" for="searchByTitle">By Event</label>
              </div>
              <div class="form-check mb-0">
                <input class="form-check-input" type="radio" name="searchType" id="searchByDate" value="date">
                <label class="form-check-label" for="searchByDate">By Date</label>
              </div>
            </div>
          </div>
          
          <!-- Date picker -->
          <div class="col-md-3">
            <input type="date" id="searchDate" class="form-control" disabled>
          </div>
        </div>
        
        <!-- Search results container -->
        <div id="searchResults" class="mt-3">
          <!-- Search results will be displayed here -->
        </div>
      </div>
    </div>
  </div>
</header>


<!-- Date Selection Modal -->
<div class="modal fade" id="dmDateModal" tabindex="-1" aria-labelledby="dmDateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title" id="dmDateModalLabel">Select Date</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <!-- Tabs -->
        <ul class="nav nav-tabs nav-fill mb-3" id="dmDateTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="dm-month-tab" data-bs-toggle="tab" data-bs-target="#dm-month-tab-pane" type="button" role="tab">
              <i class="bi bi-calendar-month me-2"></i>Month
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="dm-year-tab" data-bs-toggle="tab" data-bs-target="#dm-year-tab-pane" type="button" role="tab">
              <i class="bi bi-calendar-range me-2"></i>Year
            </button>
          </li>
        </ul>
        
        <!-- Tab content -->
        <div class="tab-content" id="dmDateTabContent">
          <!-- Month Tab -->
          <div class="tab-pane fade show active" id="dm-month-tab-pane" role="tabpanel" aria-labelledby="dm-month-tab" tabindex="0">
            <div class="p-2">
              <table class="table table-hover text-center" id="dm-month-table">
                <tbody>
                  <tr>
                    <td class="dm-month-item rounded" data-dm-month="0">January</td>
                    <td class="dm-month-item rounded" data-dm-month="1">February</td>
                    <td class="dm-month-item rounded" data-dm-month="2">March</td>
                  </tr>
                  <tr>
                    <td class="dm-month-item rounded" data-dm-month="3">April</td>
                    <td class="dm-month-item rounded" data-dm-month="4">May</td>
                    <td class="dm-month-item rounded" data-dm-month="5">June</td>
                  </tr>
                  <tr>
                    <td class="dm-month-item rounded" data-dm-month="6">July</td>
                    <td class="dm-month-item rounded" data-dm-month="7">August</td>
                    <td class="dm-month-item rounded" data-dm-month="8">September</td>
                  </tr>
                  <tr>
                    <td class="dm-month-item rounded" data-dm-month="9">October</td>
                    <td class="dm-month-item rounded" data-dm-month="10">November</td>
                    <td class="dm-month-item rounded" data-dm-month="11">December</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
          
          <!-- Year Tab -->
          <div class="tab-pane fade" id="dm-year-tab-pane" role="tabpanel" aria-labelledby="dm-year-tab" tabindex="0">
            <div class="p-2">
              <table class="table table-hover text-center" id="dm-year-table">
                <tbody>
                  <!-- Year cells will be generated dynamically by JavaScript -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" id="dm-today-btn">
          <i class="bi bi-calendar-check me-1"></i>Today
        </button>
        <button type="button" class="btn btn-primary" id="dm-confirm-btn">Confirm</button>
      </div>
    </div>
  </div>
</div>


 




<script src="/js/header.js"></script>
