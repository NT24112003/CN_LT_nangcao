<form action="/user/update?_method=PUT" method="POST" id="updateForm">
    <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" name="name" id="name" value="<%= user.name %>" maxlength="20" required>
    </div>

    <div class="mb-3">
        <label for="age" class="form-label">Age</label>
        <input type="number" class="form-control" name="age" id="age" value="<%= user.age %>" max="99" required>
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" name="email" value="<%= user.email %>" readonly>
    </div>

    <% if (!user.googleId && !user.guthubId) { %>
        <!-- Cho phép đổi mật khẩu -->
        <div class="mb-3">
            <label for="oldPassword" class="form-label">Old Password</label>
            <div class="input-group">
                <input type="password" class="form-control" name="oldPassword" id="oldPassword">
                <button class="btn btn-outline-secondary toggle-password" type="button"><i class="bi bi-eye"></i></button>
            </div>
        </div>
      
        <div class="mb-3">
            <label for="newPassword" class="form-label">New Password</label>
            <div class="input-group">
                <input type="password" class="form-control" name="newPassword" id="newPassword">
                <button class="btn btn-outline-secondary toggle-password" type="button"><i class="bi bi-eye"></i></button>
            </div>
        </div>
      <% } else { %>
        <div class="alert alert-info">
          Bạn đăng nhập bằng <%= user.googleId ? 'Google' : 'GitHub' %>. Không thể đổi mật khẩu tại đây.
        </div>
      <% } %>
      

    <div class="d-flex justify-content-end">
        <button class="btn btn-warning" type="submit">Cập nhật</button>
    </div>
</form>

<script src="/js/profile.js"></script>