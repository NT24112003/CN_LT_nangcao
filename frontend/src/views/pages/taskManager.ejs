<link rel="stylesheet" href="/css/taskManager.css">
<div class="containerTask">
    <!-- Notification Bell -->
    <div class="notification-bell">
      <button class="btn btn-link" onclick="toggleNotifications()">
        <i class="fas fa-bell"></i>
        <span class="notification-badge">0</span>
      </button>
    </div>
  
    <!-- Notification Panel -->
    <div class="notification-panel" id="notificationPanel">
      <div class="notification-header">
        <h6 class="m-0">Thông báo</h6>
      </div>
      <div class="notification-list" id="notificationList">
        <!-- Notifications will be added here -->
      </div>
    </div>
  
    <div class="container">
      <h2 class="page-title">Hệ thống quản lý nhiệm vụ</h2>
      
      <!-- Update Tabs -->
      <ul class="nav nav-pills justify-content-center" id="mainTab">
        <li class="nav-item">
          <button class="nav-link active" id="tasks-tab" onclick="showTab('tasks')">
            <i class="fas fa-list-check"></i>Danh sách nhiệm vụ
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" id="files-tab" onclick="showTab('files')">
            <i class="fas fa-file-arrow-up"></i>Danh sách file
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" id="stats-tab" onclick="showTab('stats')">
            <i class="fas fa-chart-bar"></i>Thống kê
          </button>
        </li>
      </ul>
  
      <!-- Tasks Content -->
      <div id="tasks-content" class="tab-content">
        <!-- Add Filter Section -->
        <div class="filter-section mb-3">
          <div class="row">
            <div class="col-md-4">
              <input type="text" class="form-control" id="taskSearch" placeholder="Tìm kiếm nhiệm vụ...">
            </div>
            <div class="col-md-3">
              <select class="form-control" id="taskStatus">
                <option value="">Trạng thái</option>
                <option value="Hoàn thành">Hoàn thành</option>
                <option value="Đang làm">Đang làm</option>
                <option value="Chưa bắt đầu">Chưa bắt đầu</option>
                <option value="Quá hạn">Quá hạn</option>
              </select>
            </div>
            <div class="col-md-4">
              <input type="date" class="form-control" id="taskDate">
            </div>
            <div class="col-md-1">
              <button class="btn btn-primary" onclick="filterTasks()">
                <i class="fas fa-filter"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-header">
            <h5><i class="fas fa-tasks"></i>Danh sách nhiệm vụ đã giao</h5>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Tiêu đề</th>
                    <th>Bắt đầu - Kết thúc</th>
                    <th>Người nhận</th>
                    <th>Trạng thái</th>
                    <th class="icon-column"><i class="fas fa-search"></i></th>
                  </tr>
                </thead>
                <tbody id="taskList">
                  <!-- Dữ liệu nhiệm vụ sẽ được thêm vào đây bằng JavaScript -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
  
      <!-- Files Content -->
      <div id="files-content" class="tab-content hidden">
        <!-- Add Filter Section -->
        <div class="filter-section mb-3">
          <div class="row">
            <div class="col-md-5">
              <input type="text" class="form-control" id="fileSearch" placeholder="Tìm kiếm file...">
            </div>
            <div class="col-md-5">
              <input type="date" class="form-control" id="fileDate">
            </div>
            <div class="col-md-2">
              <button class="btn btn-primary" onclick="filterFiles()">
                <i class="fas fa-filter"></i>
              </button>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-header">
            <h5><i class="fas fa-file-alt"></i>Danh sách file đã nộp</h5>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Người dùng</th>
                    <th>Tên file</th>
                    <th>Ngày gửi</th>
                    <th class="icon-column">Xem</th>
                    <th class="icon-column">Xóa</th>
                  </tr>
                </thead>
                <tbody id="fileList">
                  <!-- Dữ liệu file sẽ được thêm vào đây bằng JavaScript -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
  
      <!-- Statistics Content -->
      <div id="stats-content" class="tab-content hidden">
        <div class="filter-section mb-3">
          <div class="row">
            <div class="col-md-4">
              <select class="form-control" id="statsTimeframe">
                <option value="day">Theo ngày</option>
                <option value="week">Theo tuần</option>
                <option value="month">Theo tháng</option>
              </select>
            </div>
            <div class="col-md-4">
              <input type="text" class="form-control" id="statsUser" placeholder="Lọc theo người dùng">
            </div>
            <div class="col-md-4">
              <button class="btn btn-primary" onclick="updateStats()">
                <i class="fas fa-sync"></i> Cập nhật
              </button>
            </div>
          </div>
        </div>
  
        <div class="row chartTask">
          <div class="col-md-6">
            <div class="chart-container">
              <canvas id="taskStatusChart"></canvas>
            </div>
          </div>
          <div class="col-md-6">
            <div class="chart-container">
              <canvas id="completionTimeChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  
    <!-- Update Task Detail Modal -->
    <div class="modal fade" id="taskDetailModal" tabindex="-1" aria-labelledby="taskDetailModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="taskDetailModalLabel">Chi tiết nhiệm vụ</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body" id="taskDetailContent">
            <!-- Nội dung chi tiết nhiệm vụ sẽ được thêm vào đây bằng JavaScript -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-warning" id="extendDeadlineBtn">
              <i class="fas fa-clock"></i> Gia hạn thời gian
            </button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            <button type="button" class="btn btn-danger" id="revokeTaskBtn">
              <i class="fas fa-undo"></i> Thu hồi nhiệm vụ
            </button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Modal gia hạn thời gian -->
    <div class="modal fade" id="extendDeadlineModal" tabindex="-1" aria-labelledby="extendDeadlineModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="extendDeadlineModalLabel">Gia hạn thời gian</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form>
              <div class="mb-3">
                <label for="currentDeadline" class="form-label">Hạn chót hiện tại</label>
                <input type="text" class="form-control" id="currentDeadline" disabled>
              </div>
              <div class="mb-3">
                <label for="newDeadline" class="form-label">Hạn chót mới</label>
                <input type="datetime-local" class="form-control" id="newDeadline" required>
              </div>
              <div class="mb-3">
                <label for="reason" class="form-label">Lý do gia hạn</label>
                <textarea class="form-control" id="reason" rows="3" required></textarea>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="button" class="btn btn-primary" id="confirmExtendBtn">Xác nhận gia hạn</button>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Modal xác nhận xóa file -->
    <div class="modal fade" id="deleteFileModal" tabindex="-1" aria-labelledby="deleteFileModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="deleteFileModalLabel">Xác nhận xóa file</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p>Bạn có chắc chắn muốn xóa file "<span id="fileNameToDelete"></span>" không?</p>
            <p class="text-danger"><small>Lưu ý: Hành động này không thể hoàn tác!</small></p>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Xác nhận xóa</button>
          </div>
        </div>
      </div>
    </div>
  
</div>

<script src="/js/taskManager.js"></script>